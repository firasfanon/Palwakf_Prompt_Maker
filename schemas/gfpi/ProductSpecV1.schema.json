{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-maker:gfpi:ProductSpecV1:1.0",
  "title": "ProductSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "project_id",
    "created_at",
    "content_sha256",
    "references",
    "producer",
    "goals",
    "users",
    "roles",
    "workflows",
    "business_rules",
    "scope",
    "non_scope",
    "unresolved"
  ],
  "properties": {
    "artifact_type": {
      "const": "ProductSpecV1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "references": {
      "type": "array"
    },
    "producer": {
      "type": "object"
    },
    "goals": {
      "type": "array"
    },
    "users": {
      "type": "array"
    },
    "roles": {
      "type": "array"
    },
    "workflows": {
      "type": "array"
    },
    "business_rules": {
      "type": "array"
    },
    "scope": {
      "type": "array"
    },
    "non_scope": {
      "type": "array"
    },
    "unresolved": {
      "type": "array"
    }
  }
}
