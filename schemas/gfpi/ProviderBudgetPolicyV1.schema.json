        "TESTING",
        "OPERATIONAL"
      ]
    },
    "currency": {
      "type": "string"
    },
    "per_call_cap": {
      "type": "number"
    },
    "per_project_cap": {
      "type": "number"
    },
    "period_cap": {
      "type": "number"
    },
    "token_caps": {
      "type": "object"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "credential_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
