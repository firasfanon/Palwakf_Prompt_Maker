    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "references": {
      "type": "array"
    },
    "producer": {
      "type": "object"
    },
    "scope": {
