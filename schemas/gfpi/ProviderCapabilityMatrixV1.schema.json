{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-maker:gfpi:ProviderCapabilityMatrixV1:1.0",
  "title": "ProviderCapabilityMatrixV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "project_id",
    "created_at",
    "content_sha256",
    "references",
    "producer",
    "matrix_version",
    "corpus_sha256",
    "rows"
  ],
  "properties": {
    "artifact_type": {
      "const": "ProviderCapabilityMatrixV1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "references": {
      "type": "array"
    },
    "producer": {
      "type": "object"
    },
    "matrix_version": {
      "type": "string"
    },
    "corpus_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "rows": {
      "type": "array"
    }
  }
}
