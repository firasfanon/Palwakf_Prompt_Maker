{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-maker:gfpi:ArchitectureSpecV1:1.0",
  "title": "ArchitectureSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "project_id",
    "created_at",
    "content_sha256",
    "references",
    "producer",
    "components",
    "data_flow",
    "boundaries",
    "technology_ref",
    "unresolved"
  ],
  "properties": {
    "artifact_type": {
      "const": "ArchitectureSpecV1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "references": {
      "type": "array"
    },
    "producer": {
      "type": "object"
    },
    "components": {
      "type": "array"
    },
    "data_flow": {
      "type": "array"
    },
    "boundaries": {
      "type": "array"
    },
    "technology_ref": {
      "type": "object"
    },
    "unresolved": {
      "type": "array"
    }
  }
}
