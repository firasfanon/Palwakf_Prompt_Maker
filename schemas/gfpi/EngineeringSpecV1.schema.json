{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-maker:gfpi:EngineeringSpecV1:1.0",
  "title": "EngineeringSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "project_id",
    "created_at",
    "content_sha256",
    "references",
    "producer",
    "repo_layout",
    "devops",
    "deployment",
    "operations",
    "development_contract_ref",
    "unresolved"
  ],
  "properties": {
    "artifact_type": {
      "const": "EngineeringSpecV1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "references": {
      "type": "array"
    },
    "producer": {
      "type": "object"
    },
    "repo_layout": {
      "type": "array"
    },
    "devops": {
      "type": "array"
    },
    "deployment": {
      "type": "array"
    },
    "operations": {
      "type": "array"
    },
    "development_contract_ref": {
      "type": "object"
    },
    "unresolved": {
      "type": "array"
    }
  }
}
