{
  "name": "prompt-maker",
  "version": "1.2.0-dev",
  "private": true,
  "description": "Model-agnostic Project Definition Compiler (core + CLI + browser UI)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node tests/run.js",
    "test:browser": "node tests/browser/run.js",
    "test:all": "node tests/run.js && node tests/browser/run.js",
    "test:gfpi": "node tests/gfpi/run.js",
    "gfpi:schemas": "node tools/generateGfpiSchemas.js",
    "build:gfpi": "node tools/buildGfpiBundle.js && node tools/buildGfpiProductionBundle.js",
    "test:browser:production": "node tests/browser/gfpi_production.run.js",
    "test:browser:gfpi": "node tests/browser/gfpi.run.js",
    "companion": "node companion/cli.js",
    "eval:corpus:check": "node tools/gfpiEval.js check-corpus",
    "eval:review-status": "node tools/gfpiEval.js review-status"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
